(executable
 (name hellowv)
 ; threads.posix: the console reader runs on a background thread, so that
 ; input_line does not block the webview event loop.
 (libraries webview webview_desktop unix threads.posix))

; Stage the web/ assets next to the built binary (_build/.../examples/web/) so
; the example is self-contained in the build tree — without installing them
; into the opam switch. The binary reads them from there, or from the source
; tree when run via `dune exec`; see Webview_desktop.Locate_assets.web_dir.
(alias
 (name all)
 (deps
  (glob_files web/*)))
