(executable
 (name three)
 (libraries webview webview_desktop))

; Stage the web/ assets (including the vendored three.min.js) next to the built
; binary so the example is self-contained in the build tree, without installing
; them into the opam switch. See Webview.Utils.web_dir.
(alias
 (name all)
 (deps
  (glob_files web/*)))
