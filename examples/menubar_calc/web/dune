; The page's logic is OCaml too, compiled to JavaScript by js_of_ocaml and
; using Brr for the DOM. See ../menubar_calc.ml for the other half.
(executable
 (name app)
 (libraries brr)
 (js_of_ocaml
  (flags
   (:standard --target-env browser)))
 (modes js)
 (link_flags
  (:standard -no-check-prims)))

(rule
 (targets app.js)
 (deps app.bc.js)
 (action
  (copy %{deps} %{targets})))
